# === Vercel KV（可选，免费额度可用）===
# 在 Vercel 控制台添加 KV 存储后，会自动注入以下变量。
# 本地开发可选配置，不配也能用（会 fallback 到 demo 数据 + 内存缓存）
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# === Vercel Cron 鉴权（生产环境建议配置）===
# 配置后，/api/crawl 只接受 Authorization: Bearer <CRON_SECRET> 的请求。
CRON_SECRET=

# === 站点基础配置（可选）===
SITE_URL=https://ai-news.example.com
