# === Redis REST 缓存（生产环境必配）===
# 可使用 Upstash Redis，Vercel KV 兼容 REST API 也可继续使用。
# 部署到 CloudBase 时，在云托管服务的环境变量中配置相同变量。
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# === 定时抓取鉴权（生产环境必配）===
# Vercel Cron 或 CloudBase 定时任务调用 /api/crawl 时都需使用此密钥。
CRON_SECRET=

# === 站点基础配置（可选）===
SITE_URL=https://ai-news.example.com
